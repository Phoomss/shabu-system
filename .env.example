# Compose only. Copy to a private .env; never commit real keys or deploy credentials.
POSTGRES_USER=shabu
POSTGRES_DB=shabu_db
POSTGRES_PASSWORD=replace-with-a-private-url-safe-password
DATABASE_URL=postgresql://shabu:replace-with-a-private-url-safe-password@postgres:5432/shabu_db
JWT_SECRET=replace-with-a-private-random-signing-key
JWT_REFRESH_SECRET=replace-with-a-different-private-random-key
CUSTOMER_JWT_SECRET=
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
STAFF_PERMISSION_GRANTS={}
KITCHEN_USER_ASSIGNMENTS={}
# HTTPS deployment: production (secure refresh cookie). HTTP LAN test only: development.
APP_NODE_ENV=production
POSTGRES_PORT=5432
BACKEND_PORT=3000
FRONTEND_PORT=3001
# Build args, NOT runtime configuration. Blank = browser hostname with API/socket port 3000.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SOCKET_URL=
# Blank QR origin = the browser's actual origin. Open POS using the LAN hostname/IP for mobile QR.
NEXT_PUBLIC_APP_URL=
