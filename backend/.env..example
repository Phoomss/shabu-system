# Local PostgreSQL connection. Change these values to match your database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shabu_db?schema=public"

JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# Required only when running npm run seed:demo-users.
DEMO_USER_PASSWORD=
