# Local/test values only. Use a dedicated test database; never reset an existing DB.
DATABASE_URL=postgresql://shabu_test:shabu_test_local@127.0.0.1:55432/shabu_test
PORT=3000
JWT_SECRET=replace-with-a-local-development-secret
JWT_REFRESH_SECRET=replace-with-a-different-local-development-secret

# No implicit grants, including OWNER. Review reports/SECURITY_PERMISSION_MATRIX_TH.md.
STAFF_PERMISSION_GRANTS={}
# Server-managed raw user UUID -> authorized integer kitchen IDs; no automatic all-kitchen access.
KITCHEN_USER_ASSIGNMENTS={}
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# Optional separate strong customer signing key; otherwise domain-separated from JWT_SECRET.
# CUSTOMER_JWT_SECRET=
