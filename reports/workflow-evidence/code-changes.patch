+    api()
+      .post(`/orders/items/${id}/void`)
+      .auth(staff, { type: 'bearer' })
+      .send({ reason });
+  function event<T>(socket: Socket, name: string): Promise<T> {
+    return new Promise((resolve, reject) => {
+      const handler = (value: T) => {
+        clearTimeout(timer);
+        resolve(value);
+      };
+      const timer = setTimeout(() => {
+        socket.off(name, handler);
