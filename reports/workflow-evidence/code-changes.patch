diff --git a/backend/src/orders/order-rules.ts b/backend/src/orders/order-rules.ts
new file mode 100644
index 0000000..09156ff
--- /dev/null
+++ b/backend/src/orders/order-rules.ts
@@ -0,0 +1,27 @@
+import { BadRequestException } from '@nestjs/common';
+import { ItemStatus, OrderStatus } from '@prisma/client';
+
+// Technical request bounds, not a per-session dining quota.
+export const MAX_ORDER_ITEMS = 100;
+export const MAX_ITEM_QUANTITY = 99;
+
+export function assertItemTransition(from: ItemStatus, to: ItemStatus) {
+  const next: Record<ItemStatus, ItemStatus[]> = {
+    PENDING: [ItemStatus.PREPARING],
+    PREPARING: [ItemStatus.SERVED],
+    SERVED: [],
+    VOIDED: [],
+  };
+  if (!next[from].includes(to))
+    throw new BadRequestException(
+      `Invalid item transition: ${from} -> ${to}; VOIDED requires the audited void endpoint`,
+    );
+}
+
+export function assertOrderTransition(from: OrderStatus, to: OrderStatus) {
+  // Cancellation semantics have not been approved. Deny rather than cascade void/refund.
+  if (from !== OrderStatus.PENDING || to !== OrderStatus.CONFIRMED)
+    throw new BadRequestException(
+      `Invalid or unapproved order transition: ${from} -> ${to}`,
+    );
+}
diff --git a/backend/src/orders/order-rules.spec.ts b/backend/src/orders/order-rules.spec.ts
new file mode 100644
index 0000000..1e26e59
--- /dev/null
+++ b/backend/src/orders/order-rules.spec.ts
@@ -0,0 +1,25 @@
+import { ItemStatus, OrderStatus } from '@prisma/client';
+import { assertItemTransition, assertOrderTransition } from './order-rules';
+
+describe('Explicit workflow transitions', () => {
+  it.each(
+    Object.values(ItemStatus).flatMap((from) =>
+      Object.values(ItemStatus).map((to) => [from, to]),
+    ),
+  )('%s -> %s', (from, to) => {
+    const allowed =
+      (from === 'PENDING' && to === 'PREPARING') ||
+      (from === 'PREPARING' && to === 'SERVED');
+    if (allowed) expect(() => assertItemTransition(from, to)).not.toThrow();
+    else expect(() => assertItemTransition(from, to)).toThrow();
+  });
+  it.each(
+    Object.values(OrderStatus).flatMap((from) =>
+      Object.values(OrderStatus).map((to) => [from, to]),
+    ),
+  )('order %s -> %s', (from, to) => {
+    if (from === 'PENDING' && to === 'CONFIRMED')
+      expect(() => assertOrderTransition(from, to)).not.toThrow();
+    else expect(() => assertOrderTransition(from, to)).toThrow();
+  });
+});
