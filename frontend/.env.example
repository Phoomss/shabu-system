# Build-time browser URLs. Blank defaults to current browser hostname + port 3000.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SOCKET_URL=
# Blank uses the current browser origin for mobile QR links.
NEXT_PUBLIC_APP_URL=
# HTTPS production examples: API/socket https://api.example.com, app https://app.example.com.
# Changing these values requires rebuilding Next.js/the frontend image.
